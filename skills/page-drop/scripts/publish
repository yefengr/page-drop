#!/usr/bin/env python3
"""PageDrop 本地 CLI：打包、上传、查询、删除。

单文件、仅标准库。业务契约见仓库 docs/specification.md。
"""

import argparse
import base64
import errno
import hashlib
import http.client
import ipaddress
import json
import os
import re
import stat
import sys
import tarfile
import tempfile
import time
import urllib.parse
from datetime import datetime, timezone
from html.parser import HTMLParser
from pathlib import Path
from uuid import UUID

CONFIG_DIR = Path.home() / ".config" / "page-drop"
LEGACY_CONFIG_DIR = Path.home() / ".config" / "edge-publish"
STATE_DIR = Path.home() / ".local" / "state" / "publish"
DEFAULT_BASE_URL = ""

MAX_CONTENT_BYTES = 200 * 1024 * 1024
MAX_ARCHIVE_BYTES = 256 * 1024 * 1024
MAX_FILES = 5000
MAX_DIRS = 1000
MAX_DEPTH = 32
MAX_NAME_BYTES = 255
RETRY_WINDOW_SECONDS = 24 * 3600
CHUNK = 1024 * 1024
TTL_RE = re.compile(r"^([1-9][0-9]*)([mhd])$")
TTL_UNITS = {"m": 60, "h": 3600, "d": 86400}
TTL_MIN = 10 * 60
TTL_MAX = 30 * 86400


class CliError(Exception):
    def __init__(self, message, code=None):
        super().__init__(message)
        self.code = code


def fail(message, code=None):
    raise CliError(message, code)


def now_utc():
    return datetime.now(timezone.utc)


def iso(moment):
    return moment.replace(microsecond=0).isoformat().replace("+00:00", "Z")


def parse_iso(text):
    return datetime.fromisoformat(text.replace("Z", "+00:00"))


def parse_ttl(value):
    match = TTL_RE.match(value or "")
    if not match:
        fail("TTL 格式不合法，只接受整数加 m/h/d，例如 7d")
    seconds = int(match.group(1)) * TTL_UNITS[match.group(2)]
    if seconds < TTL_MIN or seconds > TTL_MAX:
        fail("TTL 超出范围：10 分钟到 30 天")
    return seconds


def ensure_private_dir(path):
    path.mkdir(parents=True, exist_ok=True)
    os.chmod(path, 0o700)


def fsync_directory(path):
    fd = os.open(path, os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def write_private(path, data):
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=".tmp-")
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp, path)
        fsync_directory(path.parent)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def load_config():
    config_dir = CONFIG_DIR
    path = config_dir / "config.json"
    if not path.exists():
        legacy_path = LEGACY_CONFIG_DIR / "config.json"
        if legacy_path.exists() or (
            not (CONFIG_DIR / "token").exists() and (LEGACY_CONFIG_DIR / "token").exists()
        ):
            config_dir = LEGACY_CONFIG_DIR
            path = legacy_path
    config = {"base_url": DEFAULT_BASE_URL, "token_file": str(config_dir / "token"), "timeout": 300}
    if path.exists():
        try:
            config.update(json.loads(path.read_text(encoding="utf-8")))
        except (OSError, ValueError) as exc:
            fail(f"无法读取配置 {path}: {exc}")
    return config


def load_token(config):
    for name in ("PAGE_DROP_TOKEN", "EDGE_PUBLISH_TOKEN"):
        token = os.environ.get(name, "").strip()
        if token:
            return token
    path = Path(config["token_file"])
    if not path.exists():
        fail(f"缺少 Token：{path} 不存在，且未设置非空 PAGE_DROP_TOKEN 或 EDGE_PUBLISH_TOKEN")
    token = path.read_text(encoding="utf-8").strip()
    if not token:
        fail(f"Token 文件为空：{path}")
    return token


def proxy_for(parts):
    host = parts.hostname
    if not host:
        return None
    no_proxy = (os.environ.get("NO_PROXY") or os.environ.get("no_proxy") or "").strip()
    for rule in (item.strip().lower() for item in no_proxy.split(",")):
        if not rule:
            continue
        if rule == "*":
            return None
        if rule.startswith("."):
            if host.lower().endswith(rule) or host.lower() == rule[1:]:
                return None
        elif host.lower() == rule or host.lower().endswith("." + rule):
            return None
    names = ("HTTPS_PROXY", "https_proxy", "ALL_PROXY", "all_proxy") if parts.scheme == "https" \
        else ("HTTP_PROXY", "http_proxy", "ALL_PROXY", "all_proxy")
    value = next((os.environ.get(name) for name in names if os.environ.get(name)), None)
    if not value:
        return None
    if "://" not in value:
        value = "http://" + value
    proxy = urllib.parse.urlsplit(value)
    if proxy.scheme != "http":
        fail("仅支持 http:// 代理；不支持 HTTPS 或 SOCKS 代理协议")
    if not proxy.hostname:
        fail("代理地址缺少主机名")
    try:
        proxy.port
    except ValueError:
        fail("代理端口不合法")
    return proxy


def base_parts(base_url):
    if not isinstance(base_url, str) or not base_url.strip():
        fail("未配置有效 base_url：请在 config.json 中设置自行部署的服务地址")
    try:
        parts = urllib.parse.urlsplit(base_url)
        parts.port
    except ValueError:
        fail(f"base_url 不合法：{base_url}")
    if parts.scheme not in ("http", "https") or not parts.hostname:
        fail(f"base_url 不合法：{base_url}")
    if parts.scheme != "https" and parts.hostname not in ("127.0.0.1", "localhost"):
        fail("线上 base_url 必须使用 HTTPS")
    return parts


def request(config, method, path, body=None, headers=None, body_length=None):
    parts = base_parts(config["base_url"])
    prefix = parts.path.rstrip("/")
    proxy = proxy_for(parts)
    timeout = config.get("timeout", 300)
    target = prefix + path
    proxy_headers = {}
    if proxy is not None and proxy.username is not None:
        username = urllib.parse.unquote(proxy.username)
        password = urllib.parse.unquote(proxy.password or "")
        raw = f"{username}:{password}".encode()
        proxy_headers["Proxy-Authorization"] = "Basic " + base64.b64encode(raw).decode()
    conn = None
    if proxy is not None and parts.scheme == "https":
        conn = http.client.HTTPSConnection(proxy.hostname, proxy.port or 8080, timeout=timeout)
        conn.set_tunnel(parts.hostname, parts.port or 443, headers=proxy_headers)
    elif proxy is not None:
        conn = http.client.HTTPConnection(proxy.hostname, proxy.port or 8080, timeout=timeout)
        target = f"http://{parts.hostname}:{parts.port or 80}{target}"
    else:
        conn_cls = http.client.HTTPSConnection if parts.scheme == "https" else http.client.HTTPConnection
        conn = conn_cls(parts.hostname, parts.port, timeout=timeout)
    all_headers = {"Authorization": "Bearer " + load_token(config)}
    if headers:
        all_headers.update({key: value for key, value in headers.items()
                            if key.lower() not in ("authorization", "proxy-authorization")})
    if proxy is not None and parts.scheme == "http":
        all_headers.update(proxy_headers)
    try:
        conn.putrequest(method, target)
        body_len = None
        if body is not None:
            body_len = len(body) if body_length is None else body_length
        for key, value in all_headers.items():
            conn.putheader(key, value)
        if body_len is not None:
            conn.putheader("Content-Length", str(body_len))
        conn.endheaders()
        if body is not None:
            if hasattr(body, "read"):
                while True:
                    chunk = body.read(CHUNK)
                    if not chunk:
                        break
                    conn.send(chunk)
            else:
                conn.send(body)
        response = conn.getresponse()
        payload = response.read()
        return response.status, dict(response.getheaders()), payload
    except OSError as exc:
        fail(f"网络错误：{exc}")
    finally:
        conn.close()


def parse_error(status, payload):
    try:
        data = json.loads(payload.decode("utf-8"))
        error = data.get("error", {})
        code, message = error.get("code"), error.get("message")
        if code or message:
            return code, message or f"HTTP {status}"
    except (ValueError, AttributeError, UnicodeDecodeError):
        pass
    return None, f"HTTP {status}"


def json_or_fail(status, payload, expect):
    if status in expect:
        try:
            return json.loads(payload.decode("utf-8"))
        except (ValueError, UnicodeDecodeError):
            fail("服务端返回了无法解析的 JSON")
    code, message = parse_error(status, payload)
    fail(f"{code}: {message}" if code else message, code)


class ValidatedResult(dict):
    """仅成功结果校验器产生的结果可进入本地成功收尾。"""


def validate_success(data):
    if not isinstance(data, dict):
        fail("服务端成功结果必须是 JSON 对象")
    identifier = data.get("id")
    try:
        parsed_id = UUID(identifier) if isinstance(identifier, str) else None
    except ValueError:
        parsed_id = None
    if parsed_id is None or parsed_id.version != 4 or str(parsed_id) != identifier:
        fail("服务端成功结果的 id 不是规范 UUIDv4")
    url = data.get("url")
    try:
        parts = urllib.parse.urlsplit(url) if isinstance(url, str) else None
        host = parts.hostname if parts else None
        loopback = host == "localhost"
        if host and not loopback:
            try:
                loopback = ipaddress.ip_address(host).is_loopback
            except ValueError:
                pass
        valid_url = (parts and host and parts.scheme in ("http", "https")
                     and (parts.scheme == "https" or loopback)
                     and parts.username is None and parts.password is None
                     and not parts.query and not parts.fragment
                     and parts.path.removesuffix("/").rsplit("/", 1)[-1] == identifier
                     and not any(ch.isspace() or ord(ch) < 32 for ch in url))
        if parts:
            parts.port
    except ValueError:
        valid_url = False
    if not valid_url:
        fail("服务端成功结果的 URL 必须是指向同一 UUID 的绝对 HTTPS 地址（回环允许 HTTP）")
    ranges = {"created_at": (0, 253402300799), "expires_at": (0, 253402300799),
              "bytes": (0, MAX_CONTENT_BYTES), "file_count": (1, MAX_FILES)}
    for name, (minimum, maximum) in ranges.items():
        value = data.get(name)
        if type(value) is not int or not minimum <= value <= maximum:
            fail(f"服务端成功结果的 {name} 不是合理范围的整数")
        if name.endswith("_at"):
            try:
                datetime.fromtimestamp(value, timezone.utc)
            except (ValueError, OverflowError, OSError):
                fail(f"服务端成功结果的 {name} 无法表示")
    if data["expires_at"] <= data["created_at"]:
        fail("服务端成功结果的到期时间必须晚于创建时间")
    return ValidatedResult(data)


def validate_confirmation(data, record):
    if (not isinstance(data, dict) or data.get("state") != "committed"
            or data.get("available") is not True):
        fail("服务端确认结果必须是 committed 且 available=true")
    if (data.get("archive_sha256") != record["archive_sha256"]
            or type(data.get("ttl_seconds")) is not int
            or data["ttl_seconds"] != parse_ttl(record["ttl"])
            or data.get("title") != record["title"]
            or data.get("label") != record.get("label", "")):
        fail("服务端记录与本地待确认参数不一致", "CONFLICT")
    return validate_success(data)


def relative_parts(rel):
    return rel.split("/") if rel else []


def collect(root):
    """校验目录并返回 (files, dirs, content_bytes)。files 为 [(abs, rel, size)]。"""
    root = Path(root)
    if not root.is_dir():
        fail(f"目录不存在或不是目录：{root}")
    files, dirs = [], []
    content_bytes = 0
    stack = [(root, "")]
    while stack:
        current, rel_dir = stack.pop()
        try:
            entries = sorted(os.scandir(current), key=lambda item: item.name)
        except OSError as exc:
            fail(f"无法读取目录 {current}: {exc}")
        for entry in entries:
            rel = entry.name if not rel_dir else rel_dir + "/" + entry.name
            try:
                info = entry.stat(follow_symlinks=False)
            except OSError as exc:
                fail(f"无法读取 {rel}: {exc}")
            if stat.S_ISLNK(info.st_mode):
                fail(f"不允许符号链接：{rel}")
            if any(part.startswith(".") for part in relative_parts(rel)):
                fail(f"不允许点开头的路径：{rel}")
            try:
                encoded = rel.encode("utf-8")
            except UnicodeEncodeError:
                fail(f"路径不是合法 UTF-8：{rel}")
            if len(encoded) > MAX_NAME_BYTES:
                fail(f"路径超过 {MAX_NAME_BYTES} 字节：{rel}")
            depth = len(relative_parts(rel))
            if depth > MAX_DEPTH:
                fail(f"目录层级超过 {MAX_DEPTH}：{rel}")
            if stat.S_ISDIR(info.st_mode):
                dirs.append(rel)
                if len(dirs) > MAX_DIRS:
                    fail(f"目录数超过 {MAX_DIRS}")
                stack.append((Path(entry.path), rel))
            elif stat.S_ISREG(info.st_mode):
                content_bytes += info.st_size
                if content_bytes > MAX_CONTENT_BYTES:
                    fail("内容超过 200 MiB")
                files.append((entry.path, rel, info.st_size))
                if len(files) > MAX_FILES:
                    fail(f"文件数超过 {MAX_FILES}")
            else:
                fail(f"只允许普通文件与目录：{rel}")
    if not any(rel == "index.html" for _, rel, _ in files):
        fail("根目录必须包含 index.html")
    return files, dirs, content_bytes


CSS_ROOT_RE = re.compile(
    r"url\(\s*(?P<quote>['\"]?)(?P<url>/[^\s)'\"]*)(?P=quote)\s*\)"
    r"|@import\s+['\"](?P<import>/[^'\"]*)['\"]", re.IGNORECASE)
WARNING_CHUNK = 64 * 1024
WARNING_OVERLAP = 4096


def warn_reference(filename, line, address):
    address = address.strip()
    if address.startswith("/") and not address.startswith("//"):
        # JSON 转义控制字符，避免产物文本干扰终端；地址不做自动改写。
        shown = json.dumps(address, ensure_ascii=False)
        print(f"警告：{filename}:{line}: 站点根 URL {shown} 可能不适用于 UUID 子路径", file=sys.stderr)


class CSSWarnings:
    def __init__(self, filename, line=1):
        self.filename, self.line = filename, line
        self.tail, self.offset, self.last = "", 0, -1

    def feed(self, text):
        window = self.tail + text
        for match in CSS_ROOT_RE.finditer(window):
            end = self.offset + match.end()
            if end <= self.last:
                continue
            self.last = end
            address = match.group("url") or match.group("import")
            warn_reference(self.filename, self.line + window.count("\n", 0, match.start()), address)
        keep = min(len(window), WARNING_OVERLAP)
        dropped = window[:-keep] if keep else window
        self.line += dropped.count("\n")
        self.offset += len(dropped)
        self.tail = window[-keep:] if keep else ""


class HTMLWarnings(HTMLParser):
    def __init__(self, filename):
        super().__init__(convert_charrefs=True)
        self.filename = filename
        self.css = None

    def handle_starttag(self, tag, attrs):
        line = self.getpos()[0]
        raw = self.get_starttag_text() or ""
        cursor = 0
        for name, value in attrs:
            if value is None:
                continue
            position = re.search(r"\b" + re.escape(name) + r"\s*=\s*['\"]?", raw[cursor:], re.IGNORECASE)
            if position:
                cursor += position.end()
            attr_line = line + raw.count("\n", 0, cursor)
            if name in ("src", "href", "poster"):
                warn_reference(self.filename, attr_line, value)
            elif name == "srcset":
                for match in re.finditer(r"(?:^|,)\s*(/[^\s,]*)", value):
                    value_line = attr_line + value.count("\n", 0, match.start(1))
                    warn_reference(self.filename, value_line, match.group(1))
            elif name == "style":
                CSSWarnings(self.filename, attr_line).feed(value)
        if tag == "style":
            self.css = CSSWarnings(self.filename, line)

    def handle_startendtag(self, tag, attrs):
        self.handle_starttag(tag, attrs)
        self.handle_endtag(tag)

    def handle_endtag(self, tag):
        if tag == "style":
            self.css = None

    def handle_data(self, data):
        if self.css is not None:
            self.css.feed(data)


def warn_root_references(files):
    for path, rel, _ in files:
        suffix = Path(rel).suffix.lower()
        if suffix not in (".html", ".htm", ".css"):
            continue
        scanner = CSSWarnings(rel) if suffix == ".css" else HTMLWarnings(rel)
        with open(path, encoding="utf-8", errors="replace") as handle:
            while text := handle.read(WARNING_CHUNK):
                scanner.feed(text)
                if isinstance(scanner, HTMLWarnings) and len(scanner.rawdata) > WARNING_CHUNK:
                    print(f"警告：{rel}:{scanner.getpos()[0]}: 超长 HTML 标记，静态检查已截断该段", file=sys.stderr)
                    scanner.reset()
            if isinstance(scanner, HTMLWarnings):
                scanner.close()


def sha256_file(path):
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for chunk in iter(lambda: handle.read(CHUNK), b""):
            digest.update(chunk)
    return digest.hexdigest()


def build_archive(root, target):
    files, dirs, content_bytes = collect(root)
    with tarfile.open(target, "w", format=tarfile.PAX_FORMAT) as archive:
        for rel in sorted(dirs):
            info = tarfile.TarInfo(rel)
            info.type = tarfile.DIRTYPE
            info.mode = 0o750
            info.mtime = int(time.time())
            info.uid = info.gid = 0
            info.uname = info.gname = ""
            archive.addfile(info)
        for abs_path, rel, size in sorted(files, key=lambda item: item[1]):
            info = tarfile.TarInfo(rel)
            info.size = size
            info.mode = 0o440
            info.mtime = int(os.stat(abs_path).st_mtime)
            info.uid = info.gid = 0
            info.uname = info.gname = ""
            with open(abs_path, "rb") as handle:
                archive.addfile(info, handle)
    with open(target, "r+b") as handle:
        handle.flush()
        os.fsync(handle.fileno())
    archive_bytes = os.path.getsize(target)
    if archive_bytes > MAX_ARCHIVE_BYTES:
        fail("归档超过 256 MiB")
    return {
        "archive_sha256": sha256_file(target),
        "archive_bytes": archive_bytes,
        "content_bytes": content_bytes,
        "file_count": len(files),
        "dir_count": len(dirs),
    }


def state_paths():
    return {
        "pending": STATE_DIR / "pending.json",
        "archive": STATE_DIR / "pending.tar",
        "history": STATE_DIR / "history.jsonl",
        "lock": STATE_DIR / "lock",
    }


class StateLock:
    def __enter__(self):
        import fcntl

        ensure_private_dir(STATE_DIR)
        self.handle = open(state_paths()["lock"], "a+")
        os.chmod(state_paths()["lock"], 0o600)
        try:
            fcntl.flock(self.handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            self.handle.close()
            fail("另一个 publish 进程正在使用本地状态")
        return self

    def __exit__(self, *exc):
        self.handle.close()
        return False


def load_pending():
    path = state_paths()["pending"]
    if not path.exists():
        return None
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        fail(f"pending 记录损坏：{exc}")


def save_pending(record):
    write_private(state_paths()["pending"], json.dumps(record, ensure_ascii=False, indent=2))


def clear_pending():
    # 最后才移除恢复入口；目录 fsync 失败时仍保留 pending 供下次确认。
    for key in ("archive", "pending"):
        path = state_paths()[key]
        path.unlink(missing_ok=True)
        fsync_directory(path.parent)


def scan_history(handle, key=None, identifier=None):
    """只修复被中断的无换行尾部，不掩盖完整行或中间行损坏。"""
    handle.seek(0)
    found = None
    while True:
        start = handle.tell()
        line = handle.readline()
        if not line:
            break
        try:
            item = json.loads(line)
        except (ValueError, UnicodeDecodeError):
            if not line.endswith(b"\n"):
                print(f"警告：history 尾行不完整，仅修复偏移 {start} 后的 {len(line)} 字节；保留此前完整记录。", file=sys.stderr)
                handle.seek(start)
                handle.truncate()
                break
            fail("history 含损坏的完整行；保留文件，需人工检查")
        if not isinstance(item, dict):
            fail("history 含非对象记录；保留文件，需人工检查")
        if (key is not None and item.get("key") == key
                or identifier is not None and item.get("id") == identifier):
            found = item
        if not line.endswith(b"\n"):
            handle.seek(0, os.SEEK_END)
            handle.write(b"\n")
            break
    return found


def confirmed_history(record):
    path = state_paths()["history"]
    if not path.exists():
        return None
    with open(path, "r+b") as handle:
        found = scan_history(handle, key=record["key"])
        handle.flush()
        os.fsync(handle.fileno())
    fsync_directory(path.parent)
    return validate_success(found) if found else None


def append_history(record):
    ensure_private_dir(STATE_DIR)
    path = state_paths()["history"]
    with open(path, "a+b") as handle:
        os.fchmod(handle.fileno(), 0o600)
        found = scan_history(handle, key=record["key"], identifier=record["id"])
        if found is None:
            handle.write((json.dumps(record, ensure_ascii=False) + "\n").encode("utf-8"))
        handle.flush()
        os.fsync(handle.fileno())
    # 每次同步也覆盖前次新建后目录同步失败的恢复场景。
    fsync_directory(path.parent)


def print_result(result, as_json=False):
    if as_json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
        return
    print(result.get("url"))
    expires = result.get("expires_at")
    if expires:
        print("expires  " + datetime.fromtimestamp(expires, timezone.utc).strftime("%Y-%m-%d %H:%M UTC"))


def upload(config, record):
    path = Path(record["archive"])
    with open(path, "rb") as handle:
        headers = {
            "Content-Type": "application/x-tar",
            "Idempotency-Key": record["key"],
            "X-Archive-SHA256": record["archive_sha256"],
        }
        query = urllib.parse.urlencode({
            "ttl": record["ttl"], "title": record["title"], "label": record.get("label", ""),
        })
        status, _, payload = request(
            config, "POST", "/api/v1/publishes?" + query, body=handle, headers=headers,
            body_length=record["archive_bytes"],
        )
    return validate_success(json_or_fail(status, payload, (200, 201)))


def cmd_publish(args, config):
    if args.ttl is None:
        fail("必须提供 --ttl，例如 --ttl 7d")
    parse_ttl(args.ttl)
    title = (args.title or "").strip()
    label = (args.label or "").strip()
    if len(label) > 64 or any(ord(ch) < 32 or ord(ch) == 127 for ch in label):
        fail("label 最多 64 个字符，且不能包含控制字符")
    if not args.dry_run:
        base_parts(config["base_url"])

    with StateLock():
        if load_pending():
            fail("已有待确认的上传；先执行 publish retry 或 publish discard-pending")
        root = Path(args.directory).resolve()
        files, _, _ = collect(root)
        warn_root_references(files)
        fd, tmp_path = tempfile.mkstemp(dir=str(STATE_DIR), prefix="pack-", suffix=".tar")
        os.close(fd)
        try:
            meta = build_archive(root, tmp_path)
            if args.dry_run:
                if args.json:
                    print(json.dumps({"dry_run": True, **meta}, ensure_ascii=False, indent=2))
                else:
                    print(f"可发布：{meta['file_count']} 文件 / {meta['content_bytes']} 字节，归档 {meta['archive_bytes']} 字节")
                return 0
            key = os.urandom(16).hex()
            record = {
                "key": key,
                "base_url": config["base_url"],
                "archive": str(state_paths()["archive"]),
                "archive_bytes": meta["archive_bytes"],
                "archive_sha256": meta["archive_sha256"],
                "content_bytes": meta["content_bytes"],
                "ttl": args.ttl,
                "title": title,
                "label": label,
                "source_dir": str(root),
                "first_attempt_at": iso(now_utc()),
            }
            os.chmod(tmp_path, 0o600)
            os.replace(tmp_path, state_paths()["archive"])
            fsync_directory(STATE_DIR)
            save_pending(record)
        finally:
            if os.path.exists(tmp_path):
                os.unlink(tmp_path)

        result = upload(config, record)
        finalize(result, record)
        print_result(result, args.json)
    return 0


def finalize(result, record):
    if not isinstance(result, ValidatedResult):
        fail("拒绝对未经验证的发布结果执行成功收尾")
    append_history({
        "key": record["key"],
        "id": result.get("id"),
        "url": result.get("url"),
        "expires_at": result.get("expires_at"),
        "created_at": result.get("created_at"),
        "bytes": result.get("bytes"),
        "file_count": result.get("file_count"),
        "ttl": record.get("ttl"),
        "title": record.get("title"),
        "label": record.get("label", ""),
        "archive_sha256": record.get("archive_sha256"),
        "published_at": iso(now_utc()),
    })
    clear_pending()


def cmd_retry(args, config):
    with StateLock():
        record = load_pending()
        if not record:
            fail("没有待确认的上传记录")
        if record.get("base_url") != config["base_url"]:
            fail("配置目标与待确认记录不一致：拒绝把原归档发到另一个服务", "CONFLICT")
        confirmed = confirmed_history(record)
        status, _, payload = request(config, "GET", "/api/v1/uploads/" + record["key"])
        if status == 200:
            data = json_or_fail(status, payload, (200,))
            if not isinstance(data, dict):
                fail("服务端上传查询必须返回 JSON 对象")
            if data.get("state") == "committed" or data.get("available") is not False:
                result = validate_confirmation(data, record)
                finalize(result, record)
                print_result(result, args.json)
                return 0
            if data.get("state") == "uploading":
                print("上传仍在服务端处理中，稍后再执行 publish retry", file=sys.stderr)
                return 0
            fail(f"该发布已不可访问（{data.get('state')}），不会复活旧项", "CONFLICT")
        if status != 404:
            code, message = parse_error(status, payload)
            fail(f"{code}: {message}" if code else message, code)

        if confirmed is not None:
            finalize(confirmed, record)
            print("已从本地成功记录完成收尾；不代表远端仍可访问，不会重新上传。", file=sys.stderr)
            print_result(confirmed, args.json)
            return 0
        try:
            attempted = parse_iso(record["first_attempt_at"])
            if attempted.tzinfo is None:
                attempted = attempted.replace(tzinfo=timezone.utc)
            age = (now_utc() - attempted).total_seconds()
        except (AttributeError, TypeError, ValueError):
            fail("待确认记录的时间字段异常，按重试窗口失效处理", "CONFLICT")
        if age < 0 or age >= RETRY_WINDOW_SECONDS:
            fail("超过 24 小时重试窗口，且服务端已无记录；请重新发布", "CONFLICT")
        archive = Path(record["archive"])
        if not archive.exists():
            fail("本地归档缺失，无法确认同一份内容")
        if archive.stat().st_size != record["archive_bytes"] or sha256_file(archive) != record["archive_sha256"]:
            fail("本地归档与记录不一致，拒绝重发")
        result = upload(config, record)
        finalize(result, record)
        print_result(result, args.json)
    return 0


def cmd_discard(args, config):
    with StateLock():
        record = load_pending()
        if not record:
            print("没有待确认的上传记录")
            return 0
        print("远端可能已经发布；丢弃本地记录不会删除已发布内容。", file=sys.stderr)
        clear_pending()
        print("已清除本地待确认记录与归档")
    return 0


def cmd_list(args, config):
    path = "/api/v1/publishes" + ("?all=1" if args.all else "")
    status, _, payload = request(config, "GET", path)
    data = json_or_fail(status, payload, (200,))
    items = data if isinstance(data, list) else data.get("items", [])
    if not isinstance(items, list):
        items = []
    if args.json:
        print(json.dumps(items, ensure_ascii=False, indent=2))
        return 0
    for item in items:
        state = item.get("state", "?")
        available = "ok" if item.get("available") else state
        label = f" [{item['label']}]" if item.get("label") else ""
        print(f"{item.get('id', '?')}  {available:<10} {item.get('title', '')}{label}".rstrip())
    return 0


def cmd_status(args, config):
    status, _, payload = request(config, "GET", "/api/v1/publishes/" + args.uuid)
    data = json_or_fail(status, payload, (200,))
    if args.json:
        print(json.dumps(data, ensure_ascii=False, indent=2))
        return 0
    print(f"id        {data.get('id')}")
    print(f"state     {data.get('state')}")
    print(f"available {'yes' if data.get('available') else 'no'}")
    if data.get("label"):
        print(f"label     {data['label']}")
    if data.get("available") and data.get("url"):
        print(f"url       {data['url']}")
    if data.get("expires_at"):
        print("expires   " + datetime.fromtimestamp(data["expires_at"], timezone.utc).strftime("%Y-%m-%d %H:%M UTC"))
    return 0


def cmd_url(args, config):
    status, _, payload = request(config, "GET", "/api/v1/publishes/" + args.uuid)
    data = json_or_fail(status, payload, (200,))
    if not data.get("available") or not data.get("url"):
        fail("该发布当前不可访问", "NOT_FOUND")
    print(data["url"])
    return 0


def cmd_rm(args, config):
    status, _, payload = request(config, "DELETE", "/api/v1/publishes/" + args.uuid)
    if status == 204:
        print("已删除 " + args.uuid)
        return 0
    code, message = parse_error(status, payload)
    fail(f"{code}: {message}" if code else message, code)


def build_parser(management=False):
    parser = argparse.ArgumentParser(
        prog="publish", description="PageDrop 发布工具",
        usage="publish <dir> --ttl TTL [--title TITLE] [--label LABEL] [--dry-run] [--json]\n"
              "       publish {retry,list,status,url,rm,discard-pending} ...",
        epilog="管理命令：retry / list / status / url / rm / discard-pending。"
               "发布目录与管理命令重名时请使用 ./retry 等显式路径。")
    if not management:
        parser.add_argument("directory", nargs="?", help="要发布的静态目录")
        parser.add_argument("--ttl")
        parser.add_argument("--title", default="")
        parser.add_argument("--label", default="", help="发布者标签，仅用于追溯")
        parser.add_argument("--dry-run", action="store_true")
        parser.add_argument("--json", action="store_true")
        parser.set_defaults(func=cmd_publish)
        return parser
    sub = parser.add_subparsers(dest="command", required=True)
    retry = sub.add_parser("retry", help="确认或重发上一次未确认的上传")
    retry.add_argument("--json", action="store_true")
    retry.set_defaults(func=cmd_retry)

    discard = sub.add_parser("discard-pending", help="丢弃本地待确认记录")
    discard.set_defaults(func=cmd_discard)

    listing = sub.add_parser("list", help="列出发布")
    listing.add_argument("--all", action="store_true")
    listing.add_argument("--json", action="store_true")
    listing.set_defaults(func=cmd_list)

    status = sub.add_parser("status", help="查询发布状态")
    status.add_argument("uuid")
    status.add_argument("--json", action="store_true")
    status.set_defaults(func=cmd_status)

    remove = sub.add_parser("rm", help="删除发布")
    remove.add_argument("uuid")
    remove.set_defaults(func=cmd_rm)

    url = sub.add_parser("url", help="输出可访问地址")
    url.add_argument("uuid")
    url.set_defaults(func=cmd_url)
    return parser


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    management = {"retry", "list", "status", "url", "rm", "discard-pending"}
    parser = build_parser(management=bool(argv and argv[0] in management))
    args = parser.parse_args(argv)
    if getattr(args, "func", None) is cmd_publish and not args.directory:
        parser.error("需要提供要发布的目录")
    try:
        return args.func(args, load_config())
    except CliError as exc:
        print(f"错误[{exc.code}]：{exc}" if exc.code else f"错误：{exc}", file=sys.stderr)
        return 2
    except OSError as exc:
        print(f"错误：本地或网络 I/O 失败：{exc}", file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        print("操作已中断；已有 pending 会保留，可执行 publish retry 确认。", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main())

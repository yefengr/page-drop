#!/usr/bin/env python3
"""兼容旧入口：转发到技能包内的唯一 CLI 实现。

使用 os.execv 替换当前进程，参数不经过 shell，信号、标准流和退出码
由唯一实现直接继承。
"""

import os
import sys
from pathlib import Path


if __name__ == "__main__":
    implementation = Path(__file__).resolve().parent.parent / "skills" / "page-drop" / "scripts" / "publish"
    os.execv(sys.executable, [sys.executable, str(implementation), *sys.argv[1:]])
